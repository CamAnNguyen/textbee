{{#> email-layout title='Verify your email address' preheader='One click to finish setting up your IDGroup account.'}}
  <p style='margin:0 0 14px 0;'>Hi {{name}},</p>

  <p style='margin:0 0 4px 0;'>
    Welcome to IDGroup. Confirm this address and your account is ready to send.
  </p>

  {{> email-button ctaUrl=verificationLink ctaLabel='Verify my email'}}

  {{> email-fallback-link url=verificationLink}}

  <p style='margin:20px 0 0 0; font:13px/1.6 Arial, Helvetica, sans-serif; color:#6b7280;'>
    If you did not create a IDGroup account, you can ignore this email and nothing will happen.
  </p>
{{/email-layout}}
